# Source only after replacing placeholders. Keep private overrides in an ignored .env file.
NETWORK=sepolia
CONFIG=.local/ops/reviewed-sepolia.json
MANIFEST=.local/ops/sepolia-simulation.json
# Optional archive provider override. Use a credential-free public endpoint or supply a private URL locally.
# UNISON_RPC_URL=https://your-archive-provider.example
# ACCOUNT=foundry-keystore-name
# CHROMIUM_PATH=/path/to/chromium_headless_shell-1193/chrome-linux/headless_shell
# ETHERSCAN_API_KEY is supplied privately for future verification.

# Foundry script inputs. Addresses and identifiers are public values.
# UNISON_TREASURY=<intended-direct-creator-address>
# UNISON_MANAGER=<distinct-manager-address>
# RUN_ID=<unique-32-byte-hex-agreement-id>
# ACTOR=<one-selected-signer-address>
# TERMS=<reviewed-current-terms-hash>
# POSITION=<reviewed-position-id-or-zero-bytes32>
# EXPECTED_STATE=<numeric-vault-state>
# DEADLINE=<absolute-chain-timestamp>
# BOUNDS_CONFIG=.local/ops/order.json
# REFERENCE_CONFIG=.local/ops/reference-revision.json
# CONFIRM_CHAIN=<matching-public-chain-id-for-future-broadcast-only>
